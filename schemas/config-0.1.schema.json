{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open.mekailabs.com/schemas/analysis-config-0.1.schema.json",
  "title": "Mekai Open analysis configuration 0.1",
  "$comment": "Implemented configuration for local recorded VDA 5050 3.0.0 analysis.",
  "type": "object",
  "required": ["schema", "source_id", "robots", "limits"],
  "properties": {
    "schema": {"const": "mekai.analysis_config/0.1"},
    "source_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._-]+$",
      "allOf": [
        {"not": {"enum": [".", ".."]}},
        {"not": {"pattern": "[^A-Za-z0-9._-]"}}
      ]
    },
    "robots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "type": "object",
        "required": ["subject_id", "manufacturer", "serial_number"],
        "properties": {
          "subject_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "manufacturer": {"type": "string", "maxLength": 4096},
          "serial_number": {"type": "string", "maxLength": 4096}
        },
        "additionalProperties": false
      }
    },
    "limits": {
      "type": "object",
      "required": ["message_bytes"],
      "properties": {
        "message_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864,
          "default": 8388608
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
