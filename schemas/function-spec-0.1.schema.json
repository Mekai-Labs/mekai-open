{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mekai.local/schemas/function-spec-0.1.schema.json",
  "title": "Mekai function specification 0.1",
  "type": "object",
  "required": [
    "schema",
    "function_id",
    "version",
    "qualified_id",
    "required_message_families",
    "required_fields",
    "parameters",
    "method",
    "basis",
    "missing_data_requirements",
    "result_schema",
    "fixture_ids"
  ],
  "properties": {
    "schema": {"const": "mekai.function_spec/0.1"},
    "function_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"},
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "qualified_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]*@(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "required_message_families": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["connection", "order", "instantActions", "state"]}
    },
    "required_fields": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["message_family", "fields"],
        "properties": {
          "message_family": {"enum": ["connection", "order", "instantActions", "state"]},
          "fields": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        },
        "additionalProperties": false
      }
    },
    "parameters": {"type": "object"},
    "method": {"type": "string", "minLength": 1},
    "basis": {"enum": ["REPORTED", "INFERRED"]},
    "missing_data_requirements": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "result_schema": {"const": "mekai.function_result/0.1"},
    "fixture_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "additionalProperties": false
}
