{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open.mekailabs.com/schemas/analysis-run-0.1.schema.json",
  "title": "Mekai Open analysis run 0.1",
  "type": "object",
  "required": [
    "schema",
    "analysis_id",
    "protocol",
    "qualification",
    "source",
    "configured_robots",
    "summary",
    "results",
    "exceptions"
  ],
  "properties": {
    "schema": {"const": "mekai.analysis_run/0.1"},
    "analysis_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "protocol": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {"const": "VDA 5050"},
        "version": {"const": "3.0.0"}
      },
      "additionalProperties": false
    },
    "qualification": {"const": "synthetic/lab-qualified"},
    "source": {
      "type": "object",
      "required": ["source_id", "input_sha256", "input_size_bytes"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "input_size_bytes": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "configured_robots": {"type": "array", "minItems": 1, "maxItems": 1024},
    "summary": {
      "type": "object",
      "required": ["function_result_count", "status_counts", "exception_count", "exceptions_truncated"],
      "properties": {
        "function_result_count": {"type": "integer", "minimum": 13},
        "status_counts": {
          "type": "object",
          "required": ["COMPUTED", "PARTIAL", "NOT_COMPUTABLE"],
          "additionalProperties": {"type": "integer", "minimum": 0}
        },
        "exception_count": {"type": "integer", "minimum": 0},
        "exceptions_truncated": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "results": {"type": "array", "minItems": 13},
    "exceptions": {"type": "array", "maxItems": 10000}
  },
  "additionalProperties": false
}
